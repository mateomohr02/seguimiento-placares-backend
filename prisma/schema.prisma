// Modelo de datos propio (Postgres) — ver diseño.md sección 8.
// Los campos espejados desde TeoWin mantienen el mismo nombre/casing que TeoWin
// (idEscena, idCatalogo, familia, articulo, color, medida1/2/3, unidades,
// codigoOrdenFabricacion, numeroOrdenCustom, descripcion, codigo_pedido,
// referencia, nombreComercial, idUnico). Los campos propios usan snake_case.
//
// Los dos índices únicos parciales de la sección 8.3 (WHERE estado <> 'ELIMINADO'
// / 'ELIMINADA') no son expresables en el lenguaje de schema de Prisma — se
// agregan a mano en la migración SQL generada, ver prisma/migrations/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrdenEstado {
  PENDIENTE
  EN_PROCESO
  LISTA
  ELIMINADO
}

enum PedidoEstado {
  PENDIENTE
  EN_PRODUCCION
  FINALIZADO
  ELIMINADO
}

enum ModuloEstado {
  PENDIENTE
  EN_PRODUCCION
  FINALIZADO
  ELIMINADO
}

enum DespieceTipoEstado {
  PENDIENTE
  EN_PRODUCCION
  FINALIZADO
  ELIMINADO
}

enum PiezaFisicaEstado {
  PENDIENTE
  CORTADA
  ELIMINADA
}

model Orden {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigoOrdenFabricacion Int
  numeroOrdenCustom     String
  descripcion           String
  estado                OrdenEstado @default(PENDIENTE)
  creado_en             DateTime    @default(now())
  eliminado_en          DateTime?
  archivada_en          DateTime? // archivar solo oculta la orden del listado inicial; no cambia su estado ni libera el codigoOrdenFabricacion

  pedidos     Pedido[]
  hojasCorte  HojaCorte[]

  @@map("orden")
}

model Pedido {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orden_id       String       @db.Uuid
  codigo_pedido  String
  referencia     String
  nombreComercial String
  estado         PedidoEstado @default(PENDIENTE)
  creado_en      DateTime     @default(now())
  eliminado_en   DateTime?

  orden      Orden             @relation(fields: [orden_id], references: [id])
  modulos    Modulo[]
  documentos DocumentoPedido[]
  planos     PlanoPedido[]
  escenas    EscenaPedido[]

  @@map("pedido")
}

model Modulo {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedido_id    String       @db.Uuid
  idEscena     Int
  descripcion  String
  estado       ModuloEstado @default(PENDIENTE)
  creado_en    DateTime     @default(now())
  eliminado_en DateTime?

  pedido         Pedido         @relation(fields: [pedido_id], references: [id])
  despieceTipos  DespieceTipo[]
  planos         PlanoPedido[]

  @@map("modulo")
}

model DespieceTipo {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modulo_id    String             @db.Uuid
  familia      String
  articulo     String
  color        String
  descripcion  String? // tArticuloDescripciones.descripcion para familia/articulo de la pieza (mismo join que Modulo.descripcion, §3.3) — nullable, el catálogo puede no tener descripción para algún par familia/articulo
  medida1      Decimal
  medida2      Decimal
  medida3      Decimal? // diseño.md §3.4/§3.6 no traen medida3 para piezas (solo L/P) — nullable hasta que haya una fuente
  idCatalogo   Int
  unidades     Int
  estado       DespieceTipoEstado @default(PENDIENTE)
  creado_en    DateTime           @default(now())
  eliminado_en DateTime?

  modulo        Modulo        @relation(fields: [modulo_id], references: [id])
  piezasFisicas PiezaFisica[]

  @@map("despiece_tipo")
}

model PiezaFisica {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  despiece_tipo_id String            @db.Uuid
  idUnico          Int?
  estado           PiezaFisicaEstado @default(PENDIENTE)
  escaneado_en     DateTime?
  creado_en        DateTime          @default(now())
  eliminado_en     DateTime?

  despieceTipo DespieceTipo @relation(fields: [despiece_tipo_id], references: [id])

  @@map("pieza_fisica")
}

// Hojas de corte (PDF) de una orden — feature/visor-hojas-corte. Tabla aparte, no
// toca ninguna de las existentes. El PDF se guarda en Postgres (bytea) para que
// el pg_dump de §10.3 sea el único backup. Una orden puede tener varias hojas
// (ej. MDP por un lado y MDF por otro, cada una con su "nombre"). Borrado lógico.
model HojaCorte {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orden_id       String    @db.Uuid
  nombre         String
  nombre_archivo String
  tamano         Int
  contenido      Bytes
  creado_en      DateTime  @default(now())
  eliminado_en   DateTime?

  orden       Orden                @relation(fields: [orden_id], references: [id])
  anotaciones HojaCorteAnotacion[]

  @@index([orden_id])
  @@map("hoja_corte")
}

enum AnotacionTipo {
  TEXTO
  DIBUJO
}

// Anotaciones sobre una hoja de corte. El PDF original nunca se modifica: las
// anotaciones se dibujan encima en el visor. `pagina` null = nota del documento
// (aplica a toda la hoja, ej. "las págs. 77 a 80 son MDF"). Las coordenadas en
// `datos` están normalizadas (0..1 sobre el ancho/alto de la página) para no
// depender del zoom ni del dispositivo. Borrado lógico.
model HojaCorteAnotacion {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hoja_corte_id String        @db.Uuid
  pagina        Int?
  tipo          AnotacionTipo
  datos         Json
  creado_en     DateTime      @default(now())
  eliminado_en  DateTime?

  hojaCorte HojaCorte @relation(fields: [hoja_corte_id], references: [id])

  @@index([hoja_corte_id])
  @@map("hoja_corte_anotacion")
}

enum DocumentoPedidoTipo {
  NOTA_PEDIDO
  DETALLE_REMISION
  ESCANDALLO_PLACARES
  HERRAJES_PLACARES
  ACCESORIOS_PLACARES
  HERRAJES_COCINAS
  ACCESORIOS_COCINAS
}

// Documentación de un pedido (PDF) — feature/documentacion-pedidos. Obligatorios
// para todo pedido: NOTA_PEDIDO y DETALLE_REMISION; el resto depende del tipo de
// modulación/modelos. Herrajes y accesorios son reportes distintos según la línea
// (placares / cocinas), por eso son tipos separados. Mismo esquema que hoja_corte: PDF en bytea, borrado lógico,
// el original nunca se modifica (las correcciones son anotaciones encima).
model DocumentoPedido {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedido_id      String              @db.Uuid
  tipo           DocumentoPedidoTipo
  nombre         String
  nombre_archivo String
  tamano         Int
  contenido      Bytes
  creado_en      DateTime            @default(now())
  eliminado_en   DateTime?

  pedido      Pedido                     @relation(fields: [pedido_id], references: [id])
  anotaciones DocumentoPedidoAnotacion[]

  @@index([pedido_id])
  @@map("documento_pedido")
}

// Mismo contrato que hoja_corte_anotacion (coordenadas normalizadas en `datos`).
model DocumentoPedidoAnotacion {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documento_pedido_id String        @db.Uuid
  pagina              Int?
  tipo                AnotacionTipo
  datos               Json
  creado_en           DateTime      @default(now())
  eliminado_en        DateTime?

  documento DocumentoPedido @relation(fields: [documento_pedido_id], references: [id])

  @@index([documento_pedido_id])
  @@map("documento_pedido_anotacion")
}

// Planos de un pedido (imagen JPG/PNG/WEBP o PDF) — feature/documentacion-pedidos.
// Pocos pedidos / módulos los llevan, pero cuando existen son críticos. Pueden
// asociarse a un módulo del pedido (opcional). Mismo esquema que documento_pedido:
// archivo en bytea, borrado lógico, el original nunca se modifica (las acotaciones
// y aclaraciones son anotaciones encima).
model PlanoPedido {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedido_id      String    @db.Uuid
  modulo_id      String?   @db.Uuid
  nombre         String
  nombre_archivo String
  mime           String
  tamano         Int
  contenido      Bytes
  creado_en      DateTime  @default(now())
  eliminado_en   DateTime?

  pedido      Pedido                @relation(fields: [pedido_id], references: [id])
  modulo      Modulo?               @relation(fields: [modulo_id], references: [id])
  anotaciones PlanoPedidoAnotacion[]

  @@index([pedido_id])
  @@map("plano_pedido")
}

// Mismo contrato que hoja_corte_anotacion (coordenadas normalizadas en `datos`).
model PlanoPedidoAnotacion {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plano_pedido_id String        @db.Uuid
  pagina          Int?
  tipo            AnotacionTipo
  datos           Json
  creado_en       DateTime      @default(now())
  eliminado_en    DateTime?

  plano PlanoPedido @relation(fields: [plano_pedido_id], references: [id])

  @@index([plano_pedido_id])
  @@map("plano_pedido_anotacion")
}

// Usuarios, roles y permisos — feature/usuarios-roles-permisos. Tablas aparte, no
// tocan ninguna de las existentes. Cada usuario tiene un PIN numérico (único) que
// se guarda en texto plano (decisión del usuario, app interna). Los usuarios
// y roles se administran directo en la base (no hay interfaz); `rol_permiso` es la
// tabla de funcionalidades que tiene cada rol. Un usuario no se borra: se pone
// activo = false.
model Rol {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String  @unique
  descripcion String?

  usuarios Usuario[]
  permisos RolPermiso[]

  @@map("rol")
}

// `clave` es la identidad (ej. "piezas.marcar"): el código la referencia por nombre.
model Permiso {
  clave       String @id
  descripcion String

  roles RolPermiso[]

  @@map("permiso")
}

model RolPermiso {
  rol_id        String @db.Uuid
  permiso_clave String

  rol     Rol     @relation(fields: [rol_id], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permiso_clave], references: [clave], onDelete: Cascade)

  @@id([rol_id, permiso_clave])
  @@map("rol_permiso")
}

model Usuario {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre         String    @unique
  pin            String    @unique
  rol_id         String    @db.Uuid
  activo         Boolean   @default(true)
  creado_en      DateTime  @default(now())
  ultimo_acceso  DateTime?

  rol Rol @relation(fields: [rol_id], references: [id])
  planillas UsuarioPlanilla[]
  operarios UsuarioOperario[]
  estadoProduccion UsuarioEstadoProduccion?

  @@index([rol_id])
  @@map("usuario")
}

// Qué planillas de Termolaminado puede completar cada usuario (las asigna técnica). Un
// usuario puede tener ninguna, algunas o todas. Aditiva (diseño.md §14).
model UsuarioPlanilla {
  usuario_id String           @db.Uuid
  estacion   PlanillaEstacion

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@id([usuario_id, estacion])
  @@map("usuario_planilla")
}

// Escenas 3D de un pedido (archivo .3d de TeoWin) — feature/visor-escenas-3d. Solo
// lectura: el .3d original se guarda tal cual (`contenido`, bytea) para poder
// re-interpretarlo si mejora el parser, y la geometría ya interpretada vive en
// `escena` (JSON liviano que consume el visor). Sin anotaciones. Borrado lógico.
model EscenaPedido {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedido_id      String    @db.Uuid
  nombre         String
  nombre_archivo String
  tamano         Int
  contenido      Bytes
  escena         Json
  parser_version Int
  creado_en      DateTime  @default(now())
  eliminado_en   DateTime?

  pedido Pedido @relation(fields: [pedido_id], references: [id])

  @@index([pedido_id])
  @@map("escena_pedido")
}

// Texturas de los materiales de las escenas 3D (colores de fábrica y decoración) — se copian
// una vez desde la carpeta de TeoWin (TEOWIN_3D_DIR) o se suben a mano, así el visor no depende de
// ese disco. `clave` es el código del material en minúsculas y sin el prefijo <n> (ver
// normalizarClave). Tabla aparte, aditiva.
model Textura3D {
  clave     String   @id
  nombre    String
  mime      String
  tamano    Int
  contenido Bytes
  origen    String
  creado_en DateTime @default(now())

  @@map("textura_3d")
}

// Seguimiento productivo del área de Termolaminado — feature/seguimiento-termolaminado
// (diseño.md §14). Tablas nuevas y aditivas; no tocan ninguna existente.
enum PlanillaEstacion {
  LIJADO
  ENCOLADO
  PVC
}

enum PlanillaEstado {
  BORRADOR
  GUARDADA
}

enum PlanificacionTipo {
  PEDIDOS
  RECLAMOS
}

// Una planilla por estación y día (`fecha` es el día de la carga). Se completa durante
// el día como BORRADOR (se guarda sola en el servidor, no se pierde si se cierra la
// sesión) y se cierra como GUARDADA. Corregir una planilla GUARDADA guarda antes la
// versión previa en `planilla_version`. `operarios` es la copia de los nombres
// configurados por técnica al crearla.
model PlanillaProduccion {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  area          String           @default("TERMOLAMINADO")
  estacion      PlanillaEstacion
  fecha         DateTime         @db.Date
  estado        PlanillaEstado   @default(BORRADOR)
  operarios     String[]
  creado_por    String
  modificado_por String
  creado_en     DateTime         @default(now())
  actualizado_en DateTime        @default(now())
  guardada_en   DateTime?

  filas     PlanillaFila[]
  versiones PlanillaVersion[]

  @@unique([area, estacion, fecha])
  @@index([fecha])
  @@map("planilla_produccion")
}

// Una fila = un pedido trabajado. `pedido_codigo` es el texto cargado (mayúsculas);
// `pedido_id` solo se completa si coincide exactamente con un pedido sincronizado.
// En PVC `cantidad_piezas` = mesa_chica + mesa_grande (lo calcula el backend).
model PlanillaFila {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planilla_id     String   @db.Uuid
  orden           Int
  hora_inicio     String?
  hora_fin        String?
  pedido_codigo   String   @default("")
  pedido_id       String?  @db.Uuid
  cantidad_piezas Int?
  observaciones   String?
  colocacion_pvc  String?
  perfilado       String?
  colores         String?
  mesa_chica      Int?
  mesa_grande     Int?

  planilla PlanillaProduccion @relation(fields: [planilla_id], references: [id], onDelete: Cascade)
  fotos    PlanillaFoto[]

  @@index([planilla_id])
  @@index([pedido_codigo])
  @@map("planilla_fila")
}

// Foto de la pieza antes de termolaminar (filas de PVC). Archivo en bytea, borrado lógico.
model PlanillaFoto {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fila_id      String    @db.Uuid
  mime         String
  tamano       Int
  contenido    Bytes
  creado_en    DateTime  @default(now())
  eliminado_en DateTime?

  fila PlanillaFila @relation(fields: [fila_id], references: [id], onDelete: Cascade)

  @@index([fila_id])
  @@map("planilla_foto")
}

// Versión previa de una planilla GUARDADA, tomada justo antes de aplicar una corrección.
model PlanillaVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planilla_id   String   @db.Uuid
  version       Int
  datos         Json
  guardada_por  String
  guardada_en   DateTime
  reemplazada_por String
  reemplazada_en DateTime @default(now())

  planilla PlanillaProduccion @relation(fields: [planilla_id], references: [id], onDelete: Cascade)

  @@unique([planilla_id, version])
  @@map("planilla_version")
}

// Operarios que trabajan en la estación de un usuario de fábrica (los configura técnica): salen
// como opciones al completar sus planillas. Se guardan por nombre.
model UsuarioOperario {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id String   @db.Uuid
  nombre     String
  orden      Int      @default(0)
  creado_en  DateTime @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, nombre])
  @@map("usuario_operario")
}

// Estados de producción que define técnica (ej. "Listo Termolaminado"). A cada usuario de fábrica
// se le asigna uno (puede repetirse entre usuarios): es el que marca en la planificación.
model EstadoProduccion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre    String   @unique
  orden     Int      @default(0)
  creado_en DateTime @default(now())

  usuarios UsuarioEstadoProduccion[]
  marcas   PlanificacionMarca[]

  @@map("estado_produccion")
}

model UsuarioEstadoProduccion {
  usuario_id String @id @db.Uuid
  estado_id  String @db.Uuid

  usuario Usuario          @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  estado  EstadoProduccion @relation(fields: [estado_id], references: [id], onDelete: Restrict)

  @@index([estado_id])
  @@map("usuario_estado_produccion")
}

// Planificación semanal que carga técnica a mano: una fila por pedido (o por reclamo). Los pedidos usan
// cliente / n_tw / n_orden / modelo / color / fabrica / fecha_limite; los reclamos, cliente / distribuidor /
// ticket / n_tw / tipo_reclamo / color / compromiso / finalizado_en / observaciones. `semana_inicio` es el
// lunes. Borrado lógico.
model PlanificacionItem {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  area          String            @default("TERMOLAMINADO")
  tipo          PlanificacionTipo
  semana_inicio DateTime          @db.Date
  orden         Int               @default(0)
  cliente       String            @default("")
  n_tw          String            @default("")
  n_orden       String?
  modelo        String?
  color         String?
  fabrica       DateTime?         @db.Date
  fecha_limite  DateTime?         @db.Date
  distribuidor  String?
  ticket        String?
  tipo_reclamo  String?
  compromiso    DateTime?         @db.Date
  finalizado_en DateTime?         @db.Date
  observaciones String?
  creado_en     DateTime          @default(now())
  eliminado_en  DateTime?

  marcas PlanificacionMarca[]

  @@index([area, semana_inicio, tipo])
  @@map("planificacion_item")
}

// Un estado de producción marcado en una fila de la planificación, por el usuario que lo tiene asignado.
model PlanificacionMarca {
  item_id     String   @db.Uuid
  estado_id   String   @db.Uuid
  marcado_por String
  marcado_en  DateTime @default(now())

  item   PlanificacionItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  estado EstadoProduccion  @relation(fields: [estado_id], references: [id], onDelete: Cascade)

  @@id([item_id, estado_id])
  @@map("planificacion_marca")
}
