// Modelo de datos propio (Postgres) — ver diseño.md sección 8.
// Los campos espejados desde TeoWin mantienen el mismo nombre/casing que TeoWin
// (idEscena, idCatalogo, familia, articulo, color, medida1/2/3, unidades,
// codigoOrdenFabricacion, numeroOrdenCustom, descripcion, codigo_pedido,
// referencia, nombreComercial, idUnico). Los campos propios usan snake_case.
//
// Los dos índices únicos parciales de la sección 8.3 (WHERE estado <> 'ELIMINADO'
// / 'ELIMINADA') no son expresables en el lenguaje de schema de Prisma — se
// agregan a mano en la migración SQL generada, ver prisma/migrations/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrdenEstado {
  PENDIENTE
  EN_PROCESO
  LISTA
  ELIMINADO
}

enum PedidoEstado {
  PENDIENTE
  EN_PRODUCCION
  FINALIZADO
  ELIMINADO
}

enum ModuloEstado {
  PENDIENTE
  EN_PRODUCCION
  FINALIZADO
  ELIMINADO
}

enum DespieceTipoEstado {
  PENDIENTE
  EN_PRODUCCION
  FINALIZADO
  ELIMINADO
}

enum PiezaFisicaEstado {
  PENDIENTE
  CORTADA
  ELIMINADA
}

model Orden {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigoOrdenFabricacion Int
  numeroOrdenCustom     String
  descripcion           String
  estado                OrdenEstado @default(PENDIENTE)
  creado_en             DateTime    @default(now())
  eliminado_en          DateTime?
  archivada_en          DateTime? // archivar solo oculta la orden del listado inicial; no cambia su estado ni libera el codigoOrdenFabricacion

  pedidos     Pedido[]
  hojasCorte  HojaCorte[]

  @@map("orden")
}

model Pedido {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orden_id       String       @db.Uuid
  codigo_pedido  String
  referencia     String
  nombreComercial String
  estado         PedidoEstado @default(PENDIENTE)
  creado_en      DateTime     @default(now())
  eliminado_en   DateTime?

  orden      Orden             @relation(fields: [orden_id], references: [id])
  modulos    Modulo[]
  documentos DocumentoPedido[]
  planos     PlanoPedido[]

  @@map("pedido")
}

model Modulo {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedido_id    String       @db.Uuid
  idEscena     Int
  descripcion  String
  estado       ModuloEstado @default(PENDIENTE)
  creado_en    DateTime     @default(now())
  eliminado_en DateTime?

  pedido         Pedido         @relation(fields: [pedido_id], references: [id])
  despieceTipos  DespieceTipo[]
  planos         PlanoPedido[]

  @@map("modulo")
}

model DespieceTipo {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modulo_id    String             @db.Uuid
  familia      String
  articulo     String
  color        String
  descripcion  String? // tArticuloDescripciones.descripcion para familia/articulo de la pieza (mismo join que Modulo.descripcion, §3.3) — nullable, el catálogo puede no tener descripción para algún par familia/articulo
  medida1      Decimal
  medida2      Decimal
  medida3      Decimal? // diseño.md §3.4/§3.6 no traen medida3 para piezas (solo L/P) — nullable hasta que haya una fuente
  idCatalogo   Int
  unidades     Int
  estado       DespieceTipoEstado @default(PENDIENTE)
  creado_en    DateTime           @default(now())
  eliminado_en DateTime?

  modulo        Modulo        @relation(fields: [modulo_id], references: [id])
  piezasFisicas PiezaFisica[]

  @@map("despiece_tipo")
}

model PiezaFisica {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  despiece_tipo_id String            @db.Uuid
  idUnico          Int?
  estado           PiezaFisicaEstado @default(PENDIENTE)
  escaneado_en     DateTime?
  creado_en        DateTime          @default(now())
  eliminado_en     DateTime?

  despieceTipo DespieceTipo @relation(fields: [despiece_tipo_id], references: [id])

  @@map("pieza_fisica")
}

// Hojas de corte (PDF) de una orden — feature/visor-hojas-corte. Tabla aparte, no
// toca ninguna de las existentes. El PDF se guarda en Postgres (bytea) para que
// el pg_dump de §10.3 sea el único backup. Una orden puede tener varias hojas
// (ej. MDP por un lado y MDF por otro, cada una con su "nombre"). Borrado lógico.
model HojaCorte {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orden_id       String    @db.Uuid
  nombre         String
  nombre_archivo String
  tamano         Int
  contenido      Bytes
  creado_en      DateTime  @default(now())
  eliminado_en   DateTime?

  orden       Orden                @relation(fields: [orden_id], references: [id])
  anotaciones HojaCorteAnotacion[]

  @@index([orden_id])
  @@map("hoja_corte")
}

enum AnotacionTipo {
  TEXTO
  DIBUJO
}

// Anotaciones sobre una hoja de corte. El PDF original nunca se modifica: las
// anotaciones se dibujan encima en el visor. `pagina` null = nota del documento
// (aplica a toda la hoja, ej. "las págs. 77 a 80 son MDF"). Las coordenadas en
// `datos` están normalizadas (0..1 sobre el ancho/alto de la página) para no
// depender del zoom ni del dispositivo. Borrado lógico.
model HojaCorteAnotacion {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hoja_corte_id String        @db.Uuid
  pagina        Int?
  tipo          AnotacionTipo
  datos         Json
  creado_en     DateTime      @default(now())
  eliminado_en  DateTime?

  hojaCorte HojaCorte @relation(fields: [hoja_corte_id], references: [id])

  @@index([hoja_corte_id])
  @@map("hoja_corte_anotacion")
}

enum DocumentoPedidoTipo {
  NOTA_PEDIDO
  DETALLE_REMISION
  ESCANDALLO_PLACARES
  HERRAJES_PLACARES
  ACCESORIOS_PLACARES
  HERRAJES_COCINAS
  ACCESORIOS_COCINAS
}

// Documentación de un pedido (PDF) — feature/documentacion-pedidos. Obligatorios
// para todo pedido: NOTA_PEDIDO y DETALLE_REMISION; el resto depende del tipo de
// modulación/modelos. Herrajes y accesorios son reportes distintos según la línea
// (placares / cocinas), por eso son tipos separados. Mismo esquema que hoja_corte: PDF en bytea, borrado lógico,
// el original nunca se modifica (las correcciones son anotaciones encima).
model DocumentoPedido {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedido_id      String              @db.Uuid
  tipo           DocumentoPedidoTipo
  nombre         String
  nombre_archivo String
  tamano         Int
  contenido      Bytes
  creado_en      DateTime            @default(now())
  eliminado_en   DateTime?

  pedido      Pedido                     @relation(fields: [pedido_id], references: [id])
  anotaciones DocumentoPedidoAnotacion[]

  @@index([pedido_id])
  @@map("documento_pedido")
}

// Mismo contrato que hoja_corte_anotacion (coordenadas normalizadas en `datos`).
model DocumentoPedidoAnotacion {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documento_pedido_id String        @db.Uuid
  pagina              Int?
  tipo                AnotacionTipo
  datos               Json
  creado_en           DateTime      @default(now())
  eliminado_en        DateTime?

  documento DocumentoPedido @relation(fields: [documento_pedido_id], references: [id])

  @@index([documento_pedido_id])
  @@map("documento_pedido_anotacion")
}

// Planos de un pedido (imagen JPG/PNG/WEBP o PDF) — feature/documentacion-pedidos.
// Pocos pedidos / módulos los llevan, pero cuando existen son críticos. Pueden
// asociarse a un módulo del pedido (opcional). Mismo esquema que documento_pedido:
// archivo en bytea, borrado lógico, el original nunca se modifica (las acotaciones
// y aclaraciones son anotaciones encima).
model PlanoPedido {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedido_id      String    @db.Uuid
  modulo_id      String?   @db.Uuid
  nombre         String
  nombre_archivo String
  mime           String
  tamano         Int
  contenido      Bytes
  creado_en      DateTime  @default(now())
  eliminado_en   DateTime?

  pedido      Pedido                @relation(fields: [pedido_id], references: [id])
  modulo      Modulo?               @relation(fields: [modulo_id], references: [id])
  anotaciones PlanoPedidoAnotacion[]

  @@index([pedido_id])
  @@map("plano_pedido")
}

// Mismo contrato que hoja_corte_anotacion (coordenadas normalizadas en `datos`).
model PlanoPedidoAnotacion {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plano_pedido_id String        @db.Uuid
  pagina          Int?
  tipo            AnotacionTipo
  datos           Json
  creado_en       DateTime      @default(now())
  eliminado_en    DateTime?

  plano PlanoPedido @relation(fields: [plano_pedido_id], references: [id])

  @@index([plano_pedido_id])
  @@map("plano_pedido_anotacion")
}

// Usuarios, roles y permisos — feature/usuarios-roles-permisos. Tablas aparte, no
// tocan ninguna de las existentes. Cada usuario tiene un PIN numérico (único) que
// se guarda en texto plano (decisión del usuario, app interna). Los usuarios
// y roles se administran directo en la base (no hay interfaz); `rol_permiso` es la
// tabla de funcionalidades que tiene cada rol. Un usuario no se borra: se pone
// activo = false.
model Rol {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String  @unique
  descripcion String?

  usuarios Usuario[]
  permisos RolPermiso[]

  @@map("rol")
}

// `clave` es la identidad (ej. "piezas.marcar"): el código la referencia por nombre.
model Permiso {
  clave       String @id
  descripcion String

  roles RolPermiso[]

  @@map("permiso")
}

model RolPermiso {
  rol_id        String @db.Uuid
  permiso_clave String

  rol     Rol     @relation(fields: [rol_id], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permiso_clave], references: [clave], onDelete: Cascade)

  @@id([rol_id, permiso_clave])
  @@map("rol_permiso")
}

model Usuario {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre         String    @unique
  pin            String    @unique
  rol_id         String    @db.Uuid
  activo         Boolean   @default(true)
  creado_en      DateTime  @default(now())
  ultimo_acceso  DateTime?

  rol Rol @relation(fields: [rol_id], references: [id])

  @@index([rol_id])
  @@map("usuario")
}
